<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gesture_control</name>
  <version>0.1.0</version>
  <description>Maps recognised gestures to TurtleBot3 velocity commands; sim and bringup launch files.</description>
  <maintainer email="adeel.m.zahid@gmail.com">Adeel</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>gesture_msgs</depend>
  <exec_depend>gesture_recognition</exec_depend>
  <exec_depend>turtlebot3_gazebo</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
